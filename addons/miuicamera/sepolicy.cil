; MiuiCamera (com.android.camera) di vendor LineageOS ingres
; terjemahan CIL dari device/xiaomi/miuicamera-ingres/sepolicy/vendor (platform_app.te, hal_camera_default.te)
; {nama} = type yang di-resolve dari policy vendor/plat (versi), {APP} = platform_app & priv_app
; (app bertanda tangan platform donor = platform_app, selain itu priv_app).
; Baris yang type-nya tidak ada di policy dibuang otomatis oleh addon_tool.py.
(typeattributeset halclientdomain ({APP}))
(typeattributeset vendor_hal_camerapostproc_xiaomi_client ({APP}))
(allow {APP} {hal_camera_default} (binder (call transfer)))
(allow {hal_camera_default} {APP} (binder (transfer)))
(allow {APP} {hal_camera_default} (fd (use)))
(allow {hal_camera_default} {APP} (binder (call transfer)))
(allow {APP} {hal_camera_default} (binder (transfer)))
(allow {hal_camera_default} {APP} (fd (use)))
(allow {APP} {vendor_hal_camerapostproc_xiaomi} (binder (call transfer)))
(allow {vendor_hal_camerapostproc_xiaomi} {APP} (binder (transfer)))
(allow {APP} {vendor_hal_camerapostproc_xiaomi} (fd (use)))
(allow {vendor_hal_camerapostproc_xiaomi} {APP} (binder (call transfer)))
(allow {APP} {vendor_hal_camerapostproc_xiaomi} (binder (transfer)))
(allow {vendor_hal_camerapostproc_xiaomi} {APP} (fd (use)))
(allow {APP} {vendor_hal_camerapostproc_xiaomi_hwservice} (hwservice_manager (find)))
(allow {APP} {adsprpcd_file} (dir (open read search)))
(allow {APP} {vendor_xdsp_device} (chr_file (ioctl open read write)))
(allow {APP} {vendor_qdsp_device} (chr_file (ioctl open read write)))
(allow {APP} {vendor_camera_data_file} (dir (ioctl read write getattr lock append map open watch watch_reads search)))
(allow {APP} {vendor_camera_data_file} (file (getattr open read)))
(allow {APP} {app_data_file} (file (execute)))
; app priv_app (MiuiCamera bertanda tangan testkey, donor kunci privat): data app berlabel
; privapp_data_file, bukan app_data_file -> izin execute yang sama (library/model yang diekstrak ke data app)
(allow {APP} {privapp_data_file} (file (execute)))
(allow {APP} {vendor_camera_sensor_prop} (file (ioctl read getattr lock map open watch watch_reads)))
(allow {APP} {vendor_display_prop} (file (ioctl read getattr lock map open watch watch_reads)))
(allow {APP} {vendor_panel_info_prop} (file (ioctl read getattr lock map open watch watch_reads)))
